[Unit]
Description=InkyPi BLE Peripheral
# Deliberately NOT ordered after inkypi.service — Flask waits on
# network-online.target, which can hang for ~60-90s at a relocated
# Pi whose saved Wi-Fi isn't in range. Blocking BLE on that defeats
# its primary purpose (provisioning new Wi-Fi when no network exists
# yet). The BLE handlers tolerate Flask being absent (bridge calls
# return 599; INFO reports flask_reachable=false), so coming up
# before / without Flask is safe.
After=bluetooth.service
Wants=bluetooth.service

[Service]
User=root
# Power on the adapter and enable pairability at every service start.
# This makes the JustWorks pairing fix idempotent across upgrades —
# existing installs that still have Pairable=false in main.conf get
# overridden each time the service starts, so users don't need to
# re-run install.sh. The persistent NoInputNoOutput agent is
# registered in-process by ble/pairing_agent.py — putting it here
# wouldn't persist because bluetoothctl drops the agent on exit.
ExecStartPre=-/usr/bin/bluetoothctl power on
ExecStartPre=-/usr/bin/bluetoothctl pairable on
ExecStartPre=-/usr/bin/bluetoothctl discoverable on
ExecStart=/usr/local/bin/inkypi-ble
# Watchdog inside service.py self-stops if BlueZ has dropped our
# advertisement (bless 0.3.0 can lose it silently on a central
# disconnect). Restart=always means a clean exit triggered by that
# self-stop still bounces the service so advertising is restored
# within ~5s. systemctl stop still works — systemd treats explicit
# stop requests separately from auto-restart.
Restart=always
RestartSec=5
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
CPUQuota=15%
MemoryMax=80M

[Install]
WantedBy=multi-user.target
