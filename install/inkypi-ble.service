[Unit]
Description=InkyPi BLE Peripheral
After=bluetooth.service inkypi.service
Wants=bluetooth.service

[Service]
User=root
ExecStart=/usr/local/bin/inkypi-ble
# Watchdog inside service.py self-stops if BlueZ has dropped our
# advertisement (bless 0.3.0 can lose it silently on a central
# disconnect). Restart=always means a clean exit triggered by that
# self-stop still bounces the service so advertising is restored
# within ~5s. systemctl stop still works — systemd treats explicit
# stop requests separately from auto-restart.
Restart=always
RestartSec=5
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
CPUQuota=15%
MemoryMax=80M

[Install]
WantedBy=multi-user.target
